# Public HTTPS reverse-proxy template. Copy to nginx.public.conf after editing
# server_name and certificate paths; do not load this example directly.
worker_processes 1;
error_log logs/little-battle-public-error.log notice;
pid logs/little-battle-public.pid;

events {
    worker_connections 1024;
}

http {
    include D:/Tool/nginx-1.31.8/conf/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 30;
    client_max_body_size 64k;

    # Keep port 80 available for ACME HTTP-01 certificate renewal.
    server {
        listen 80;
        server_name game.example.com;

        location ^~ /.well-known/acme-challenge/ {
            root D:/GitHub/little_battle_assets/deploy/acme-webroot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name game.example.com;

        # Replace these with the PEM certificate/key files issued for your domain.
        ssl_certificate D:/Tool/certs/game.example.com/fullchain.pem;
        ssl_certificate_key D:/Tool/certs/game.example.com/private.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;

        location = /assets/manifest.json {
            alias D:/GitHub/little_battle_assets/public/manifest.json;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location /assets/releases/ {
            alias D:/GitHub/little_battle_assets/public/releases/;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /health {
            proxy_pass http://127.0.0.1:8787/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8787;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            return 404;
        }
    }
}
